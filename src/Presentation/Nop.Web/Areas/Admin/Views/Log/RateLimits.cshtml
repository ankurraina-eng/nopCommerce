@model RateLimitLogListModel

@{
    //page title
    ViewBag.PageTitle = T("Admin.System.RateLimitLog").Text;
    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName("Rate limit log");
}

<div class="content-header clearfix">
    <h1 class="float-left">
        @T("Admin.System.RateLimitLog")
        <small>
            <i class="fas fa-arrow-circle-left"></i>
            <a asp-action="List">@T("Admin.System.Log.BackToList")</a>
        </small>
    </h1>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="form-horizontal">
            <div class="cards-group">
                <div class="card card-default">
                    <div class="card-body">
                        <p>
                            @T("Admin.System.RateLimitLog.Hint")
                        </p>
                        @if (!Model.Logs.Any())
                        {
                            <p>
                                @T("Admin.System.RateLimitLog.Empty")
                            </p>
                        }
                        else
                        {
                            <table class="table table-hover table-bordered">
                                <thead>
                                    <tr>
                                        <th>@T("Admin.System.Log.Fields.CreatedOn")</th>
                                        <th>@T("Admin.System.Log.Fields.LogLevel")</th>
                                        <th>@T("Admin.System.Log.Fields.ShortMessage")</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var log in Model.Logs)
                                    {
                                        <tr>
                                            <td>
                                                <a asp-controller="Log" asp-action="View" asp-route-id="@log.Id">
                                                    @log.CreatedOn.ToString("g")
                                                </a>
                                            </td>
                                            <td>
                                                <a asp-controller="Log" asp-action="View" asp-route-id="@log.Id">
                                                    @log.LogLevel
                                                </a>
                                            </td>
                                            <td>
                                                <a asp-controller="Log" asp-action="View" asp-route-id="@log.Id">
                                                    @Html.Raw(log.ShortMessage)
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
